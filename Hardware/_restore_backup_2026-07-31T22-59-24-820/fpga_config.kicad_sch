	(text_box "When OE is low (LGA is absent), the switch closes, bypassing the LGA JTAG interface."
		(exclude_from_sim no)
		(at 49.53 158.75 0)
		(size 22.86 15.24)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type solid)
		)
		(fill
			(type none)
		)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "be347fb6-7f36-4f34-8f66-ddb9f0f9aa5d")
	)
	(text_box "According to UG470 Chapter 2 \"Configuration Interfaces\"\n\nDefault is M[2:0] = 0b111\nThis is the \"Slave Serial\" mode, where an external device drives CCLK in Bank 0 and D01_DIN in Bank 14 to configure the FPGA.\n\nTo use this or another method (e.g. Master SPI), use the LGA interface to drive the mode pins and provide the configuration memory device.\n\nPins brought to LGA and therefore supported configuration modes are undecided."
		(exclude_from_sim no)
		(at 135.89 34.29 0)
		(size 71.12 26.4392)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type solid)
		)
		(fill
			(type none)
		)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "de726693-fc2d-43da-a04d-f5c1af0e0630")
	)
	(text_box "By default, PUDC_B is high.  If user wants PUDC_B low, they may tie it to GND on the LGA board."
		(exclude_from_sim no)
		(at 245.11 34.3047 0)
		(size 19.05 20.3053)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type solid)
		)
		(fill
			(type none)
		)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "e4b7abc3-c841-47e6-ad84-7507f045a756")
	)
